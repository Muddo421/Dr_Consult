<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ✅ Permissions must be OUTSIDE <application> -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DrConsult"
        tools:targetApi="31">

        <!-- FCM Notification Service -->
        <service
            android:name=".DrConsultMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".splashscreen"
            android:exported="true"
            android:theme="@style/Theme.DrConsult">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth -->
        <activity android:name=".LoginView"          android:exported="false" />
        <activity android:name=".SignupView"          android:exported="false" />
        <activity android:name=".RoleSelectionActivity" android:exported="false" />

        <!-- Main -->
        <activity android:name=".MainActivity"        android:exported="false" />

        <!-- Doctor -->
        <activity android:name=".DoctorProfileActivity"      android:exported="false" />
        <activity android:name=".DoctorRegistrationActivity" android:exported="false" />
        <activity android:name=".DoctorAvailabilityActivity" android:exported="false" />

        <!-- Appointments -->
        <activity android:name=".BookAppointmentActivity" android:exported="false" />
        <activity android:name=".AppointmentsActivity"    android:exported="false" />

        <!-- Messaging -->
        <activity android:name=".MessagesActivity" android:exported="false" />
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".IncomingCallActivity"
            android:exported="false"
            android:showOnLockScreen="true"/>
        <!-- Profile -->
        <activity android:name=".UserProfileActivity" android:exported="false" />

        <!-- Admin -->
        <activity android:name=".AdminVerificationActivity" android:exported="false" />

        <!-- Video Call -->
        <activity android:name=".VideoCallActivity" android:exported="false" />



    </application>

</manifest>